---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();

const socials = [
  { href: 'https://github.com/o-louis', icon: 'carbon:logo-github', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/olouis', icon: 'carbon:logo-linkedin', label: 'LinkedIn' },
  { href: 'mailto:oriane.louis.pro@gmail.com', icon: 'carbon:email', label: 'Email' },
];
---

<footer class="border-t border-line py-10 text-sm">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-subtle">
      © {year} Oriane - built with Astro
    </p>
    <ul class="flex items-center gap-4">
      {
        socials.map(({ href, icon, label }) => (
          <li>
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={label}
              class="text-subtle hover:text-accent transition-colors"
            >
              <Icon name={icon} class="size-[18px]" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
