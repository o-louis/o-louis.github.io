---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title="Work - Oriane"
  description="Selected case studies from production work."
>
  <section class="py-8">
    <h1 class="text-3xl font-medium tracking-tight">Work</h1>
    <p class="mt-4 max-w-xl text-muted">
      The two roles that shaped how I work today. AdTech and Smart TV -
      different worlds, same thread: frontend on hard constraints.
    </p>

    <ul class="mt-12 divide-y divide-line">
      {
        work.map((entry) => (
          <li>
            <a
              href={`/work/${entry.id}`}
              class="group block py-6"
            >
              <div class="flex items-baseline justify-between gap-6">
                <h2 class="font-medium tracking-tight text-fg group-hover:text-accent transition-colors">
                  {entry.data.title}
                </h2>
                <span class="shrink-0 font-mono text-xs text-subtle">
                  {entry.data.period}
                </span>
              </div>
              <p class="mt-1 text-sm text-muted max-w-2xl">
                {entry.data.summary}
              </p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {entry.data.stack.map((tech) => (
                  <li class="font-mono text-[11px] text-subtle">{tech}</li>
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
