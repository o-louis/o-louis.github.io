---
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate, isoDate } from '../../lib/posts';

const posts = await getPosts();
---

<Layout
  title="Blog - Oriane"
  description="Notes on frontend engineering, Vue, TypeScript, and building UI under constraints."
>
  <section class="py-8">
    <h1 class="text-3xl font-medium tracking-tight">Blog</h1>
    <p class="mt-4 max-w-xl text-muted">
      Notes on frontend engineering, what I run into, what I'd do differently,
      and the occasional thing worth writing down.
    </p>

    {
      posts.length === 0 && (
        <p class="mt-12 text-sm text-subtle">Nothing published yet.</p>
      )
    }

    <ul class="mt-12 divide-y divide-line">
      {
        posts.map((post) => (
          <li>
            <a href={`/posts/${post.id}`} class="group block py-6">
              <div class="flex items-baseline justify-between gap-6">
                <h2 class="font-medium tracking-tight text-fg group-hover:text-accent transition-colors">
                  {post.data.title}
                </h2>
                <time
                  datetime={isoDate(post.data.pubDate)}
                  class="shrink-0 font-mono text-xs text-subtle"
                >
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              <p class="mt-1 max-w-2xl text-sm text-muted">
                {post.data.description}
              </p>
              {post.data.tags.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li class="font-mono text-[11px] text-subtle">{tag}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
