---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import { getPosts, formatDate, isoDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} - Oriane`} description={post.data.description}>
  <article class="py-8">
    <a href="/posts" class="link-hover text-sm text-subtle">← All posts</a>

    <header class="mt-8 border-b border-line pb-8">
      <h1 class="max-w-2xl text-3xl font-medium tracking-tight sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{post.data.description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-subtle">
        <time datetime={isoDate(post.data.pubDate)}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate && (
            <span>Updated {formatDate(post.data.updatedDate)}</span>
          )
        }
        {post.data.tags.length > 0 && <span>{post.data.tags.join(', ')}</span>}
      </div>
    </header>

    <Prose class="mt-10">
      <Content />
    </Prose>
  </article>
</Layout>
